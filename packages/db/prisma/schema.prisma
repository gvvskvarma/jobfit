generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

// ---------- Per-user tables (row-level security in migrations/*_rls) ----------

model User {
  id             String          @id // Clerk user id
  email          String          @unique
  visaStatus     VisaStatus?
  authEndDate    DateTime? // EAD or I-94 end date; caps the grace period
  bannedWords    String[]
  createdAt      DateTime        @default(now())
  role           Role            @default(USER)
  skills         Skill[]
  evidence       Evidence[]
  applications   Application[]
  employmentGaps EmploymentGap[]
  auditLogs      AuditLog[]
}

enum VisaStatus {
  H1B
  OPT
  STEM_OPT
  L1
  GC_PENDING
  CITIZEN_OR_GC
  OTHER
}

enum Role {
  USER
  ADMIN
}

/// Periods without qualifying employment. Drives the visa clock (SPEC 8.7).
model EmploymentGap {
  id     String    @id @default(cuid())
  userId String
  start  DateTime
  end    DateTime? // null = still unemployed
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A skill the user has CONFIRMED or DENIED. Agent memory lives here.
model Skill {
  id          String      @id @default(cuid())
  userId      String
  name        String // normalized, e.g. "prisma"
  status      SkillStatus
  context     String?
  confirmedAt DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

enum SkillStatus {
  CONFIRMED
  DENIED
  UNKNOWN
}

/// Verified resume facts, embedded locally into `embedding` (pgvector).
model Evidence {
  id        String                      @id @default(cuid())
  userId    String
  kind      EvidenceKind
  company   String?
  project   String?
  text      String
  tags      String[]
  startDate DateTime?
  endDate   DateTime?
  // ponytail: no ANN index; exact scan per user is instant at a few hundred rows. Add HNSW via raw SQL if banks grow.
  embedding Unsupported("vector(384)")?
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EvidenceKind {
  BULLET
  PROJECT
  ACHIEVEMENT
  CERT
  EDUCATION
}

model JobPosting {
  id           String        @id @default(cuid())
  userId       String
  source       String? // "pasted" | "email" | url
  company      String?
  title        String?
  rawText      String
  parsed       Json?
  screening    Json?
  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([userId])
}

model Application {
  id              String      @id @default(cuid())
  userId          String
  jobPostingId    String?
  company         String
  role            String
  status          AppStatus   @default(DRAFT)
  callback        Boolean     @default(false)
  matchScore      Int?
  resumeVersionId String?
  notes           String?
  appliedAt       DateTime?
  nextAction      String?
  nextActionAt    DateTime?
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting      JobPosting? @relation(fields: [jobPostingId], references: [id])

  @@index([userId, nextActionAt])
}

enum AppStatus {
  DRAFT
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  NO_RESPONSE
  SKIPPED
}

model ResumeVersion {
  id            String   @id @default(cuid())
  userId        String
  applicationId String?
  content       Json
  docxKey       String? // R2 object key
  createdAt     DateTime @default(now())

  @@index([userId])
}

/// Grounded drafts other than the resume. `content` matches the schema for `kind`.
model Draft {
  id            String    @id @default(cuid())
  userId        String
  applicationId String?
  kind          DraftKind
  content       Json
  createdAt     DateTime  @default(now())

  @@index([userId])
}

enum DraftKind {
  APPLICATION_ANSWERS
  COVER_LETTER
  RECRUITER_NOTE
  REFERRAL_ASK
  INTERVIEW_PREP
}

model AuditLog {
  id     String   @id @default(cuid())
  userId String
  action String
  target String?
  meta   Json?
  at     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IngestEvent {
  idempotencyKey String   @id
  status         String // "processing" | "done" | "failed"
  attempts       Int      @default(0)
  lastError      String?
  updatedAt      DateTime @updatedAt
}

// ---------- Public employer data, written by the ETL (services/agent/etl) ----------
// IDs are generated by Postgres because the Python ETL inserts these rows.

model Employer {
  id             String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  normalizedName String              @unique
  displayName    String
  aliases        String[]
  naics          String?
  capExemptHint  Boolean             @default(false) // a hint, never a determination
  lcaStats       EmployerYearStats[]
  wageBands      WageBand[]

  @@index([displayName])
}

model EmployerYearStats {
  id                       String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  employerId               String
  fiscalYear               Int
  lcaCertified             Int
  lcaTotal                 Int
  changeEmployer           Int
  newEmployment            Int
  h1bDependent             Boolean
  willfulViolator          Boolean
  uscisInitialApprovals    Int?
  uscisInitialDenials      Int?
  uscisContinuingApprovals Int?
  uscisContinuingDenials   Int?
  permTotal                Int?
  permCertified            Int?
  employer                 Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@unique([employerId, fiscalYear])
}

/// Certified LCAs per employer x SOC x title bucket x state x year.
/// Wages are annualized USD; percentiles are null when fewer than 5 valid wages.
model WageBand {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  employerId     String
  fiscalYear     Int
  socCode        String
  titleBucket    String
  worksiteState  String
  n              Int
  changeEmployer Int
  p25            Int?
  median         Int?
  p75            Int?
  employer       Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@unique([employerId, fiscalYear, socCode, titleBucket, worksiteState])
  @@index([titleBucket, worksiteState, fiscalYear])
}

model DatasetVersion {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  source     String // "LCA" | "USCIS" | "PERM"
  fiscalYear Int
  sourceUrl  String
  sha256     String
  loadedAt   DateTime @default(now())

  @@unique([source, fiscalYear])
}

/// parse_jd results keyed by a hash of the posting text, model and prompts (SPEC 8.8),
/// so the same posting is never parsed twice. Shared across users; holds no user data.
model ParsedJdCache {
  hash      String   @id
  parsed    Json
  createdAt DateTime @default(now())
}
