# Copy to .env.local (gitignored). Local Docker database from docker-compose.yml:
DATABASE_URL=postgresql://jobfit:jobfit@localhost:5432/jobfit_local

# Claude, for the screening service (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Clerk sign-in (dashboard.clerk.com > API keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The web app signs its calls to the screening service with this; any long random string (openssl rand -hex 32)
AGENT_HMAC_SECRET=
AGENT_URL=http://localhost:8000
